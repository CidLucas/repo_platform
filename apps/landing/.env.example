# Supabase (same instance the dashboard uses — session is shared on same origin)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key

# Where to send the user after onboarding completes.
# Defaults to /dashboard (same-origin, handled by nginx in docker).
VITE_DASHBOARD_URL=/dashboard

# HubSpot Private App Access Token (legacy /api/contact endpoint)
# Obtenha em: HubSpot > Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_access_token
